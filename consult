#!/usr/bin/env python3
"""consult — run an AI agent CLI (codex/claude) sandboxed by nono.

Guarantees, enforced by nono at the OS level (not by trusting the agent):
  - the directory you run it in is READ-ONLY (the agent cannot change your files)
  - the network and all the agent's own abilities stay ON

Usage — the rule is: dash means raw, word means prompt.
  consult <agent> "prompt or prompt-file" [output-file] [session-file]
      Simple mode, identical shape for both agents. The prompt is a literal
      string, or a path to a file holding it. The final answer goes to the
      terminal, or to output-file if given ('-' keeps it on the terminal).
      The session file carries the conversation: absent or empty, a new
      session starts and its id is saved there; holding an id, that session
      is resumed. Both files must be OUTSIDE this directory — the sandbox
      makes this directory read-only.
  consult <agent> -<flag> [args...]   raw mode: a leading '-' passes ALL args
                                      through to the agent untouched
  consult <agent> -- <args...>        raw mode, explicit — for bare words,
                                      e.g. consult codex -- exec "..."
  consult <agent>                     interactive session, sandboxed
  consult --help                      this help

Examples:
  consult codex  "review the auth flow"
  consult claude "review the auth flow"                # same shape, same behavior
  consult codex  ./q1.md /tmp/a1.txt /tmp/r.session    # starts a session
  consult codex  ./q2.md /tmp/a2.txt /tmp/r.session    # resumes it
  consult codex  --help                                # codex's own help
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path

# Everything agent-specific lives in this table; the rest of the script is
# mechanism. Keys:
#   inject   always placed right after the agent name (codex: forgo its own
#            macOS sandbox — it cannot nest inside nono's, which stays the
#            single enforcing sandbox)
#   oneshot  simple mode, new conversation
#   assign   simple mode, new conversation recorded under a chosen {id}
#            (None: the agent picks its own id — capture it from its output)
#   resume   simple mode, continue conversation {id}
#   output   route the final answer to {out} (None: redirect stdout instead)
#   stdin    trailing args that make the agent read the prompt from stdin
AGENT = {
    "codex": {
        "inject":  ["-c", 'sandbox_mode="danger-full-access"'],
        "oneshot": ["exec", "--skip-git-repo-check"],
        "assign":  None,
        "resume":  ["exec", "resume", "--skip-git-repo-check", "{id}"],
        "output":  ["-o", "{out}"],
        "stdin":   ["-"],
    },
    "claude": {
        "inject":  [],
        # -p cannot ask for approval, so it denies any tool not allowed up
        # front: pre-allow the web tools (other approval-gated tools stay denied)
        "oneshot": ["-p", "--strict-mcp-config", "--allowedTools=WebFetch,WebSearch"],
        "assign":  ["-p", "--strict-mcp-config", "--allowedTools=WebFetch,WebSearch",
                    "--session-id", "{id}"],
        "resume":  ["-p", "--strict-mcp-config", "--allowedTools=WebFetch,WebSearch",
                    "--resume", "{id}"],
        "output":  None,
        "stdin":   [],
    },
}

SESSION_ID = re.compile(r"session id:\s*(\S+)", re.IGNORECASE)

HERE = Path(__file__).resolve().parent  # resolve() so a symlink install finds profiles/


def die(msg, code=2):
    print(f"consult: {msg}", file=sys.stderr)
    sys.exit(code)


def selftest(profile):
    """Run a throwaway write probe in the current directory under the sandbox.
    Returns (ok, why): ok only if the sandbox applied and denied the write."""
    script = (
        "p=.consult_selftest_$$; "
        'if (: > "$p") 2>/dev/null; then rm -f "$p" 2>/dev/null; echo WRITABLE; '
        "else echo READONLY; fi"
    )
    cmd = ["nono", "run", "-s", "--profile", str(profile), "--allow-cwd",
           "--", "sh", "-c", script]
    try:
        probe = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return False, "sandbox self-test timed out after 60s"
    except Exception as e:
        return False, f"sandbox self-test could not run: {e}"
    if "WRITABLE" in probe.stdout:
        return False, ("this directory is writable inside the sandbox — your project "
                       "is in a writable location like /tmp or a cache dir")
    if probe.returncode == 0 and "READONLY" in probe.stdout:
        return True, ""
    err = (probe.stderr or probe.stdout).strip() or f"nono exited {probe.returncode}"
    return False, f"the sandbox did not start: {err}"


def writable_path_or_die(path_arg, what):
    path = Path(path_arg).resolve()
    if path.is_relative_to(Path.cwd()):
        die(f"{what} must be OUTSIDE this directory — the sandbox makes it "
            "read-only. Use /tmp or another writable location.")
    return path


def wire_simple(agent, positionals):
    """Simple mode: <prompt-or-file> [output-file] [session-file].
    Returns (args, session): the agent's argv tail plus the session action —
    ("write", path, id) to record a pre-chosen id, ("capture", path) to
    harvest the agent's own id from its output, or None. Wires stdin (and
    stdout, when the answer is routed by redirect) to survive execvp."""
    spec = AGENT[agent]
    if len(positionals) > 3:
        die("simple mode takes at most three arguments: "
            "<prompt-or-file> [output-file] [session-file]. "
            "For raw agent arguments use: consult <agent> -- <args...>")
    prompt, outfile, sessionfile = (positionals + [None, None])[:3]
    if outfile == "-":
        outfile = None
    if not prompt:
        die("empty prompt.")

    if Path(prompt).is_file():
        fd = os.open(prompt, os.O_RDONLY)
    else:
        tmp = tempfile.TemporaryFile()
        tmp.write(prompt.encode())
        tmp.flush()
        tmp.seek(0)
        fd = tmp.fileno()
    os.dup2(fd, 0)

    mode, session_id, session = "oneshot", "", None
    if sessionfile:
        spath = writable_path_or_die(sessionfile, "session file")
        session_id = spath.read_text().strip() if spath.is_file() else ""
        if session_id:
            mode = "resume"
        elif spec["assign"]:
            mode, session_id = "assign", str(uuid.uuid4())
            session = ("write", spath, session_id)
        else:
            session = ("capture", spath)

    args = [part.replace("{id}", session_id) for part in spec[mode]]
    if outfile:
        out = writable_path_or_die(outfile, "output file")
        if spec["output"]:
            args += [part.replace("{out}", str(out)) for part in spec["output"]]
        else:
            os.dup2(os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644), 1)
    return args + spec["stdin"], session


def run_capturing_session(cmd, spath):
    """Stay attached instead of execvp: codex announces the session id in its
    progress stream (stderr), so relay that stream and save the id."""
    child = subprocess.Popen(cmd, stderr=subprocess.PIPE, text=True)
    found = None
    for line in child.stderr:
        sys.stderr.write(line)
        sys.stderr.flush()
        found = found or SESSION_ID.search(line)
    code = child.wait()
    if found is None:
        die("the agent reported no session id; session file not written.", code=7)
    try:
        spath.write_text(found.group(1) + "\n")
    except OSError as e:
        die(f"cannot write session file: {e}", code=7)
    sys.exit(code)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)

    agent, rest = args[0], args[1:]
    if agent not in AGENT:
        die(f"unknown agent '{agent}'. Supported: {', '.join(AGENT)}.")
    if shutil.which("nono") is None:
        die("nono is not installed / not on PATH; refusing to run the agent "
            "unsandboxed. Install nono first.", code=3)
    if shutil.which(agent) is None:
        die(f"'{agent}' is not installed / not on PATH.", code=6)

    profile = HERE / "profiles" / f"consult-{agent}.json"
    if not profile.is_file():
        die(f"profile not found: {profile}", code=5)

    # Dash means raw, word means prompt.
    session = None
    if not rest:
        agent_args = []  # interactive session
    elif rest[0] == "--":
        agent_args = rest[1:]
    elif rest[0].startswith("-"):
        agent_args = rest
    else:
        agent_args, session = wire_simple(agent, rest)

    ok, why = selftest(profile)
    if not ok:
        die(f"refusing to run — {why}.", code=4)

    cmd = ["nono", "run", "-s", "--profile", str(profile), "--allow-cwd",
           "--", agent, *AGENT[agent]["inject"], *agent_args]
    if session:
        action, spath = session[0], session[1]
        if action == "capture":
            run_capturing_session(cmd, spath)
        try:
            spath.write_text(session[2] + "\n")
        except OSError as e:
            die(f"cannot write session file: {e}", code=7)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
